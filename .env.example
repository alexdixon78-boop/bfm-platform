# ─────────────────────────────────────────────────────────────
# Brighter Future Mediation CRM — environment variables example
# Copy this file to `.env` and fill in real values to run locally.
# Never commit your real `.env` file.
# ─────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────

# local | aws
# Use `local` for normal development from this file.
# Use `aws` on AWS so the app loads Secrets Manager + Parameter Store through
# the instance IAM role before starting.
CONFIG_SOURCE=local

# PostgreSQL connection string. On Replit this is provided automatically;
# locally you need your own Postgres database. After setting it, run
# `npm run db:push` to create the tables.
DATABASE_URL=postgresql://user:password@localhost:5432/bfm_crm
# Managed/remote Postgres usually requires SSL. Leave unset for auto-detect,
# set DATABASE_SSL=false for a local/non-SSL server, or PGSSLMODE=require.
# DATABASE_SSL=true

# Long random string used to sign login session cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
# Local HTTP development can force non-secure cookies. Omit this or set true
# on AWS/ECS behind HTTPS so browser sessions use Secure cookies.
SESSION_COOKIE_SECURE=false

# Base URL the app runs at (used for links in emails etc.)
APP_URL=http://localhost:5000

# ── Google Calendar / OAuth ──────────────────────────────────
# From Google Cloud Console (APIs & Services → Credentials).
# Add the redirect URI below to your OAuth client's authorised redirect URIs.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# ── Email (SendGrid) ─────────────────────────────────────────
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Where admin notification emails are sent
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# Calendly webhook signing key used to verify direct Calendly webhook payloads.
# Keep this secret in local .env / Replit Secrets / deployment secrets.
CALENDLY_PAT=
CALENDLY_ORGANIZATION_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=

# ── Stripe Checkout payments ─────────────────────────────────
# Used by public MIAM booking links. Keep these secret in local .env /
# Replit Secrets / deployment secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Xero Custom Connection invoices ───────────────────────────
# Create a Custom Connection for the single target organisation. It uses
# client credentials; no redirect URI or browser connection flow is needed.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_WEBHOOK_KEY=
XERO_DEFAULT_ACCOUNT_CODE=
XERO_DEFAULT_TAX_TYPE=
XERO_DEFAULT_BRANDING_THEME_ID=

# ── WhatsApp / Meta Cloud API ────────────────────────────────
# Secrets belong in local .env / Replit Secrets / deployment secrets.
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_DEFAULT_TEMPLATE=bfm_case_update
META_WHATSAPP_GRAPH_VERSION=v20.0
META_WHATSAPP_ENQUIRY_FLOW_ID=
META_WHATSAPP_ENQUIRY_FLOW_SCREEN=ENQUIRY_FORM

# ── Optional ─────────────────────────────────────────────────

# Shared BFM calendar mailbox (used for auto-accepting Google events)
BFM_CALENDAR_EMAIL=testingfuture6@gmail.com

# Fallback base URL for links (APP_URL takes precedence where used)
BASE_URL=http://localhost:5000

# Server port (defaults to 5000)
PORT=5000

# ── File storage ──────────────────────────────────────────────
# local keeps proof uploads on disk for development.
# s3 is required for AWS ECS/Fargate so uploads survive task replacement.
STORAGE_DRIVER=local
S3_UPLOAD_BUCKET=
S3_UPLOAD_REGION=eu-west-2
S3_UPLOAD_PREFIX=mediator-service-approvals
# Optional S3 server-side encryption value, e.g. AES256 or aws:kms
S3_UPLOAD_SSE=

# development | production
NODE_ENV=development

# ── AWS config loader (AWS development server only) ──────────
# The AWS server should set only these bootstrap values directly. The app will
# retrieve the real secrets/config through the IAM role attached to the server.
AWS_REGION=us-east-1
SECRETMANGER_NAME=dev-secret
# Backward-compatible fallback if SECRETMANGER_NAME is unset:
# AWS_SECRETS_MANAGER_SECRET_ID=/bfm/dev/app/secrets
AWS_PARAMETER_STORE_PATH=/bfm/dev/app/config/
# Local development fallback only. Prefer IAM roles on AWS/ECS/EC2.
# ACCESS_KEY=
# SECRET_KEY=

# Note: REPL_ID, REPL_SLUG, REPL_OWNER and REPLIT_DEV_DOMAIN appear in the
# code but are Replit-internal — you can ignore them when running locally.
# Use these scopes in Google OAuth consent screen:
# https://www.googleapis.com/auth/calendar.events
# https://www.googleapis.com/auth/userinfo.email

# â”€â”€ Microsoft Outlook / OAuth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Create an app registration in Azure Portal and add the redirect URI below.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/callback/outlook

# ── Connected-calendar availability import ──────────────────
# Required for authenticated provider webhooks. Generate with: openssl rand -hex 32
CALENDAR_WEBHOOK_SECRET=
# Provider subscriptions also require APP_URL to be a public HTTPS origin.
